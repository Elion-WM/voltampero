# VoltAmpero .gitignore
# Keeps the repository clean and professional

# ========================================
# Python
# ========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ========================================
# Virtual Environments
# ========================================

python/
venv/
env/
ENV/
.venv/
virtualenv/

# ========================================
# Debug and Log Files
# ========================================

# Generic log files
*.log

# Debug text files
debug_*.txt
timing_*.txt
capture_*.txt
ramp_debug.txt
debug_log.txt

# Test output files in testing folder
testing/*.log
testing/*.txt
testing/*.csv

# BUT keep these important text files:
!requirements.txt
!LICENSE
!testing/README.txt

# ========================================
# Excel Temporary Files
# ========================================

# Excel lock files (created when file is open)
~$*.xlsm
~$*.xlsx
~$*.xls

# Excel temporary files
*.tmp
*.temp

# ========================================
# IDE and Editor Files
# ========================================

# Visual Studio Code
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.*.sw[a-p]

# Emacs
\#*\#
.\#*

# ========================================
# Operating System Files
# ========================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
*~
.directory
.Trash-*

# ========================================
# Project-Specific
# ========================================

# Backup files
*_backup_*.xlsm
*.bak
*.backup

# CSV log files (test outputs)
voltampero_log_*.csv
test_log.csv

# Temporary Python installer
get-pip.py

# Test/diagnostic scripts output
ping.txt
working_off_command.txt

# ========================================
# Security - NEVER COMMIT THESE!
# ========================================

# Environment variables (if you create any)
.env
.env.local
.env.*.local

# Secrets
secrets.txt
passwords.txt
api_keys.txt
config_local.py

# ========================================
# Git
# ========================================

# Git backup files
*.orig

# ========================================
# Documentation Build Files (if you add Sphinx later)
# ========================================

docs/_build/
docs/_static/
docs/_templates/

# ========================================
# Testing
# ========================================

.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# ========================================
# Optional: Uncomment if needed
# ========================================

# Jupyter Notebook checkpoints
# .ipynb_checkpoints/

# PyInstaller (if you create .exe)
# *.spec

# mypy type checker
# .mypy_cache/
# .dmypy.json
# dmypy.json

# ========================================
# End of .gitignore
# ========================================
